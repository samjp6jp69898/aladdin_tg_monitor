<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aladdin.tg-monitor-dual-track</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/user/aladdin/tg-monitor/launchd/run-dual-track.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/user/aladdin/tg-monitor</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/user/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>LANG</key>
        <string>en_US.UTF-8</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/user/aladdin/tg-monitor/data/launchd-dual-track.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/user/aladdin/tg-monitor/data/launchd-dual-track.err.log</string>
</dict>
</plist>
